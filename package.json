{
  "name": "dsh-ugreen-nas",
  "version": "0.2.0",
  "description": "UGREEN NAS OpenCLI connector for DeepSeek Harness: scoped access-token auth over HTTPS, permission-aware tools covering the full 70-permission surface (files, storage, tasks, docker, downloads, apps, control panel).",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ugreen",
    "nas",
    "opencli"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-0 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-0 || ^0.2.0-0 || ^0.2.1-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node test/smoke.test.mjs",
    "build:catalog": "node scripts/build-catalog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuvkB/dsh-ugreen-nas.git"
  },
  "homepage": "https://github.com/BuvkB/dsh-ugreen-nas#readme",
  "bugs": {
    "url": "https://github.com/BuvkB/dsh-ugreen-nas/issues"
  },
  "author": "BuvkB"
}